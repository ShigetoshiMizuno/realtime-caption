openai:
  # 平文形式（後方互換）: "sk-xxxxxxxxxxxxxxxxxxxx"
  # b64 難読化形式: "b64:<base64エンコード済み文字列>"  ← GUI の「保存」ボタンで自動生成
  # 注意: b64 は暗号化ではなく難読化のみ。config.yaml をバージョン管理に含めないこと。
  api_key: "sk-xxxxxxxxxxxxxxxxxxxx"  # OpenAI を使う場合に入力

deepl:
  # 同上。GUI の「詳細設定」→「API キー設定」→「保存」で b64 形式に変換される。
  api_key: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx"  # DeepL を使う場合に入力

translation:
  target_language: "日本語"
  translation_model: "deepl"  # "openai" または "deepl" または "openai-realtime"
  system_prompt: "与えられたテキストを自然な{target_language}に翻訳してください。翻訳結果のみ返してください。"

whisper:
  model: "small"   # small または medium
  language: null   # 入力言語コード（null で自動検出 / "en" や "ja" で固定）
  compute_type: "int8"   # int8（CPU推奨・高速）/ float16（GPU推奨）/ float32（精度優先・遅い）
  device: "cpu"          # cpu / cuda（GPU 環境のみ）

websocket:
  host: "localhost"
  port: 8765

output:
  log_dir: "."  # 翻訳ログの出力ディレクトリ（YYYY-MM-DD-n_translate.txt を自動生成）

audio:
  host_api: "wasapi"  # "wasapi"（デフォルト）/ "all" / "mme" / "directsound"
                      # "wasapi" にすると MME/DirectSound 等の重複エントリを非表示にできる
                      # デバイスが見えない場合は "all" に変更してください

vad:
  silero_sensitivity: 0.4    # 低いほど拾いやすい（0.0〜1.0、デフォルト 0.4）
  post_speech_silence_duration: 0.6  # 無音何秒で発話終了（秒）

rpc:
  port: 8767

openai_realtime:                          # openai-realtime モード専用設定（他のモードでは無視）
  model: "gpt-realtime-translate"         # 使用モデル名（config で変更可能）
  target_language_code: "ja"             # 出力言語（BCP-47: "ja" "en" "es" 等）
  connect_timeout: 10                    # 接続タイムアウト（秒）
  reconnect_max_attempts: 5             # 最大再接続試行回数
  reconnect_backoff_base: 1.5           # 指数バックオフの底（n回目は base^n 秒待機）
  max_session_minutes: 60               # 自動停止するまでの最大稼働時間（分）。0 で無制限
  audio_output:                          # Zoom 同時通訳用音声出力設定（任意）
    enabled: false                       # true: 仮想マイクへの音声出力を有効化（VB-CABLE 等）
    output_device: "CABLE Input"         # 出力デバイス名（部分一致。VB-CABLE インストール後に有効）
    sample_rate: 24000                   # 出力サンプルレート（gpt-realtime-translate は 24000Hz）

# 翻訳こんにゃくモード設定（Issue #38）
# 自分↔相手の双方向同時翻訳。経路A（相手の声→自分の字幕）+ 経路B（自分の声→相手のマイク）を並列実行。
# 各経路で独立した入出力デバイス・翻訳先言語・出力音量を設定可能。
# GUI の「翻訳こんにゃくモード」プリセットボタンで自動入力されます。
translation_konnyaku:
  route_a:
    # 相手の音声を取り込み、自分の母語に翻訳して字幕表示する経路
    input_device_keyword: ""        # 入力デバイス名キーワード（例: "Loopback"）。空欄なら GUI で選択
    target_language_code: "ja"      # 翻訳先言語コード（BCP-47: ja/en、将来 zh/ko/es 拡張）
    audio_output_enabled: false     # 翻訳音声の出力を有効化する場合は true
    output_device_keyword: ""       # 出力デバイス名キーワード
    output_volume: 1.0              # 出力音量倍率（0.0〜2.0）
  route_b:
    # 自分の音声を取り込み、相手の言語に翻訳して仮想マイクへ出力する経路
    input_device_keyword: ""        # マイクデバイス名キーワード
    target_language_code: "en"      # 翻訳先言語コード
    audio_output_enabled: true      # 仮想マイク出力のため true 推奨
    output_device_keyword: "CABLE Input"   # VB-CABLE 仮想マイク（VB-CABLE インストール後に有効）
    output_volume: 1.0
