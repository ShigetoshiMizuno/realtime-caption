# APIキーを含む設定ファイル（絶対にコミットしない）
config.yaml

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.coverage
.pytest_cache/

# Embeddable Python（大容量・start.bat で自動インストール）
python/

# AIモデルキャッシュ（大容量・start.bat で自動ダウンロード）
models/
*.bin
*.pt

# ログファイル（ユーザの会話内容が含まれるため絶対にコミットしない）
*_translate.txt
*_verbose.txt
*.log

# その他
*.docx
*.pdf
新規*
settings.json

# Claude セッション間の引き継ぎメモ
# handover/*.md は git 管理（共有用）、*.done.md はローカル完了マーカーで除外
handover/*.done.md

# raw_logs（ハルシネーション防止用の一次資料、ローカルのみ）
raw_logs/
